<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kanishk AI - Ultimate Universal AI Assistant</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Poppins:wght@600;700;800&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg: #0a0a0a;
  --bg2: #121212;
  --bg3: #1a1a1a;
  --bg4: #252525;
  --sb: #0f0f0f;
  --hov: #2a2a2a;
  --ibg: #171717;
  --txt: #f5f5f5;
  --txt2: #b0b0b0;
  --txt3: #808080;
  --txt4: #606060;
  --green: #10a37f;
  --green-dark: #0d7a60;
  --green-light: #1abc9c;
  --accent: #7c3aed;
  --accent2: #a855f7;
  --pink: #ec4899;
  --pink-dark: #be185d;
  --bdr: #3d3d3d;
  --bdr2: #4a4a4a;
  --success: #10b981;
  --warning: #f59e0b;
  --error: #ef4444;
  --info: #3b82f6;
  --r: 14px;
  --rsm: 10px;
  --sw: 300px;
}

html, body {
  height: 100%;
  background: var(--bg);
  color: var(--txt);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  font-size: 15px;
  line-height: 1.6;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-thumb {
  background: var(--bdr);
  border-radius: 8px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--bdr2);
}

#app {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* SIDEBAR */
#sidebar {
  width: var(--sw);
  background: var(--sb);
  border-right: 1px solid var(--bdr);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease;
  overflow: hidden;
  z-index: 100;
}

.sb-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 16px;
  border-bottom: 1px solid var(--bdr);
  background: linear-gradient(135deg, rgba(16,163,127,0.1) 0%, transparent 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16px;
  font-weight: 800;
  color: var(--txt);
  text-decoration: none;
  letter-spacing: -0.5px;
  font-family: 'Poppins', sans-serif;
}

.brand-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 8px 20px rgba(16, 163, 127, 0.4);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 8px 20px rgba(16, 163, 127, 0.4); }
  50% { box-shadow: 0 8px 30px rgba(16, 163, 127, 0.6); }
}

.ib {
  background: none;
  border: none;
  color: var(--txt2);
  cursor: pointer;
  padding: 10px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.ib:hover {
  background: var(--hov);
  color: var(--green);
}

.new-chat {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 10px;
  padding: 13px 16px;
  border-radius: var(--rsm);
  background: linear-gradient(135deg, var(--accent2) 0%, var(--accent) 100%);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all 0.2s;
}

.new-chat:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(122, 60, 237, 0.4);
}

.sb-sec {
  padding: 12px 18px 8px;
  font-size: 12px;
  font-weight: 700;
  color: var(--txt3);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-top: 12px;
}

#chat-list {
  flex: 1;
  overflow-y: auto;
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.chi {
  padding: 12px 14px;
  border-radius: var(--rsm);
  cursor: pointer;
  font-size: 13px;
  color: var(--txt2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border: 1px solid transparent;
}

.chi:hover {
  background: var(--hov);
  color: var(--txt);
  border-color: var(--bdr2);
}

.chi.active {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  color: #fff;
  border-color: var(--green);
}

.chi .del {
  display: none;
  background: none;
  border: none;
  color: var(--txt3);
  cursor: pointer;
  padding: 6px 8px;
  border-radius: 6px;
}

.chi:hover .del {
  display: flex;
}

.chi .del:hover {
  color: #fff;
  background: rgba(239, 68, 68, 0.8);
}

.sb-bot {
  border-top: 1px solid var(--bdr);
  padding: 12px;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: var(--rsm);
  cursor: pointer;
  transition: all 0.2s;
}

.user-row:hover {
  background: var(--hov);
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.uname {
  font-size: 13px;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

#sb-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 50;
  backdrop-filter: blur(5px);
}

/* MAIN */
#main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

#topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 1px solid var(--bdr);
  gap: 12px;
  background: linear-gradient(135deg, var(--bg2) 0%, var(--bg3) 100%);
}

.model-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border: 1px solid var(--bdr);
  border-radius: 24px;
  background: var(--bg3);
  color: var(--txt);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.model-btn:hover {
  background: var(--hov);
  border-color: var(--green);
}

.model-indicator {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--success);
  animation: blink 2s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.tb-right {
  display: flex;
  gap: 8px;
}

#mob-topbar {
  display: none;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid var(--bdr);
  background: var(--bg2);
}

/* CHAT AREA */
#chat-area {
  flex: 1;
  overflow-y: auto;
  scroll-behavior: smooth;
}

#welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  padding: 50px 20px 180px;
  text-align: center;
  background: linear-gradient(180deg, var(--bg) 0%, var(--bg2) 100%);
}

.wl-logo {
  width: 72px;
  height: 72px;
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  font-weight: 800;
  color: #fff;
  margin-bottom: 28px;
  box-shadow: 0 12px 40px rgba(16, 163, 127, 0.4);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.wl-title {
  font-size: 32px;
  font-weight: 800;
  color: var(--txt);
  letter-spacing: -1px;
  margin-bottom: 12px;
  font-family: 'Poppins', sans-serif;
}

.wl-badge {
  display: inline-block;
  background: linear-gradient(135deg, rgba(16, 163, 127, 0.15) 0%, rgba(26, 188, 156, 0.15) 100%);
  border: 1.5px solid var(--green);
  color: var(--green);
  padding: 8px 16px;
  border-radius: 24px;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 24px;
}

.wl-sub {
  font-size: 16px;
  color: var(--txt2);
  margin-bottom: 48px;
  max-width: 500px;
  line-height: 1.8;
}

.suggs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
  max-width: 800px;
  width: 100%;
}

.sc {
  background: var(--bg3);
  border: 1px solid var(--bdr);
  border-radius: var(--r);
  padding: 18px;
  text-align: left;
  cursor: pointer;
  transition: all 0.3s;
}

.sc:hover {
  background: var(--bg4);
  border-color: var(--green);
  transform: translateY(-4px);
}

.sc-ico {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: rgba(16, 163, 127, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  font-size: 20px;
}

.sc-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--txt);
  margin-bottom: 6px;
}

.sc-desc {
  font-size: 12px;
  color: var(--txt3);
}

/* MESSAGES */
#messages {
  display: none;
  max-width: 900px;
  margin: 0 auto;
  padding: 32px 20px 200px;
  width: 100%;
}

.mr { {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  margin-top: 4px;
}

.mav.aav {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  color: #fff;
}

.mav.uav {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  color: #fff;
}

.mb {
  flex: 1;
}

.mlbl {
  font-size: 12px;
  font-weight: 700;
  color: var(--txt2);
  margin-bottom: 8px;
}

.mt {
  font-size: 15px;
  line-height: 1.8;
  color: var(--txt);
  word-break: break-word;
}

.mr.user .mt {
  background: linear-gradient(135deg, var(--accent2) 0%, var(--accent) 100%);
  border: 1px solid rgba(168, 85, 247, 0.3);
  padding: 14px 18px;
  border-radius: 18px 18px 4px 18px;
  display: inline-block;
  max-width: 100%;
  color: #fff;
}

.mt p {
  margin-bottom: 14px;
}

.mt p:last-child {
  margin-bottom: 0;
}

.mt ul, .mt ol {
  padding-left: 28px;
  margin-bottom: 14px;
}

.mt li {
  margin-bottom: 8px;
}

.mt strong {
  font-weight: 700;
  color: var(--green);
}

.mt em {
  font-style: italic;
  color: var(--txt2);
}

.mt a {
  color: var(--green-light);
  text-decoration: underline;
}

.mt h1, .mt h2, .mt h3 {
  font-weight: 800;
  margin: 16px 0 8px;
  font-family: 'Poppins', sans-serif;
}

.mt h1 { font-size: 24px; }
.mt h2 { font-size: 20px; }
.mt h3 { font-size: 18px; }

.cblk {
  background: var(--bg);
  border: 1px solid var(--bdr);
  border-radius: var(--rsm);
  margin: 14px 0;
  overflow: hidden;
}

.chdr {
  display: flex;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid var(--bdr);
  background: var(--bg3);
}

.clng {
  font-size: 11px;
  color: var(--txt3);
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
  text-transform: uppercase;
}

.ccp {
  background: none;
  border: none;
  color: var(--txt3);
  font-size: 12px;
  cursor: pointer;
  padding: 6px 12px;
  border-radius: 6px;
  transition: all 0.2s;
}

.ccp:hover {
  color: var(--green);
  background: rgba(16, 163, 127, 0.15);
}

.cblk pre {
  padding: 16px;
  overflow-x: auto;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  line-height: 1.7;
  color: var(--txt);
}

.macts {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  opacity: 0;
  transition: opacity 0.2s;
  flex-wrap: wrap;
}

.mr:hover .macts {
  opacity: 1;
}

.abt {
  background: none;
  border: none;
  color: var(--txt3);
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 8px;
  font-size: 12px;
  transition: all 0.15s;
}

.abt:hover {
  background: var(--hov);
  color: var(--txt);
}

.dots {
  display: flex;
  gap: 6px;
  padding: 14px 0;
}

.dot {
  width: 8px;
  height: 8px;
  background: var(--txt3);
  border-radius: 50%;
  animation: bounce 1.4s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.7; }
  30% { transform: translateY(-10px); opacity: 1; }
}

/* INPUT */
#inp-area {
  flex-shrink: 0;
  padding: 12px 18px 18px;
  background: var(--bg);
  position: relative;
}

#inp-area::before {
  content: '';
  position: absolute;
  top: -50px;
  left: 0;
  right: 0;
  height: 50px;
  background: linear-gradient(transparent, var(--bg));
  pointer-events: none;
}

.inpwrap {
  max-width: 900px;
  margin: 0 auto;
}

.inpbox {
  display: flex;
  align-items: flex-end;
  background: var(--ibg);
  border: 1.5px solid var(--bdr);
  border-radius: 18px;
  padding: 12px 14px;
  gap: 10px;
  transition: all 0.2s;
}

.inpbox:focus-within {
  border-color: var(--green);
  background: var(--bg2);
}

#uinp {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  color: var(--txt);
  font-size: 15px;
  font-family: inherit;
  resize: none;
  max-height: 220px;
  min-height: 24px;
  line-height: 1.5;
  padding: 6px 0;
  overflow-y: auto;
}

#uinp::placeholder {
  color: var(--txt3);
}

.sbtn {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  border: none;
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  opacity: 0.4;
}

.sbtn.rdy {
  opacity: 1;
}

.sbtn.rdy:hover {
  transform: translateY(-2px);
}

.sbtn svg {
  color: #fff;
  width: 20px;
  height: 20px;
}

.inpfoot {
  text-align: center;
  margin-top: 10px;
  font-size: 11px;
  color: var(--txt3);
}

/* MODAL */
.mbg {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
  backdrop-filter: blur(8px);
}

.mbg.open {
  opacity: 1;
  pointer-events: all;
}

.modal {
  background: linear-gradient(135deg, var(--bg2) 0%, var(--bg3) 100%);
  border: 1px solid var(--bdr);
  border-radius: 18px;
  width: min(520px, 94vw);
  padding: 28px;
  transform: scale(0.95);
  transition: transform 0.2s;
  max-height: 90vh;
  overflow-y: auto;
}

.mbg.open .modal {
  transform: scale(1);
}

.mhd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26px;
}

.mtitle {
  font-size: 20px;
  font-weight: 800;
  font-family: 'Poppins', sans-serif;
}

.srow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
  border-bottom: 1px solid var(--bdr);
  gap: 12px;
}

.srow:last-child {
  border-bottom: none;
}

.slbl {
  font-size: 14px;
  font-weight: 700;
}

.sdesc {
  font-size: 12px;
  color: var(--txt3);
  margin-top: 3px;
}

.stginp {
  background: var(--bg);
  border: 1px solid var(--bdr);
  color: var(--txt);
  padding: 10px 14px;
  border-radius: 10px;
  font-size: 13px;
  width: 100%;
  outline: none;
  transition: all 0.2s;
}

.stginp:focus {
  border-color: var(--green);
}

/* TOAST */
#toast {
  position: fixed;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--bg3);
  border: 1px solid var(--bdr);
  color: var(--txt);
  padding: 12px 24px;
  border-radius: 24px;
  font-size: 13px;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s;
  z-index: 999;
  font-weight: 600;
}

#toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* RESPONSIVE */
@media (max-width: 768px) {
  #sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    transform: translateX(-100%);
  }

  #sidebar.open {
    transform: translateX(0);
  }

  #sb-overlay.show {
    display: block;
  }

  #topbar {
    display: none;
  }

  #mob-topbar {
    display: flex;
  }

  .suggs {
    grid-template-columns: 1fr;
  }

  #messages {
    padding-bottom: 200px;
  }
}

@media (max-width: 480px) {
  .wl-title {
    font-size: 22px;
  }

  .wl-logo {
    width: 60px;
    height: 60px;
    font-size: 28px;
  }
}
</style>
</head>
<body>
<div id="app">

<div id="sidebar">
  <div class="sb-top">
    <a class="brand" href="#">
      <div class="brand-icon">🤖</div>
      Kanishk AI
    </a>
    <button class="ib" id="close-sb" onclick="closeSB()">✕</button>
  </div>

  <button class="new-chat" onclick="newChat()">➕ New Chat</button>

  <div class="sb-sec" id="hist-lbl" style="display:none">Recent</div>
  <div id="chat-list"></div>

  <div class="sb-bot">
    <div class="user-row" onclick="openSets()">
      <div class="avatar" id="uav">K</div>
      <div class="uname" id="uname">Kanishk</div>
      <span>⚙️</span>
    </div>
  </div>
</div>

<div id="sb-overlay" onclick="closeSB()"></div>

<div id="main">
  <div id="topbar">
    <button class="model-btn">
      <div class="model-indicator"></div>
      <span>🧠 Kanishk AI Ultimate</span>
    </button>
    <div class="tb-right">
      <button class="ib" onclick="newChat()">➕</button>
      <button class="ib" onclick="openSets()">⚙️</button>
      <button class="ib" onclick="openSB()">☰</button>
    </div>
  </div>

  <div id="mob-topbar">
    <button class="ib" onclick="openSB()">☰</button>
    <div>Kanishk AI</div>
    <button class="ib" onclick="newChat()">➕</button>
  </div>

  <div id="chat-area">
    <div id="welcome">
      <div class="wl-logo">🤖</div>
      <div class="wl-title">Kanishk AI Ultimate</div>
      <div class="wl-badge">✨ All-in-One AI • 20000+ Lines</div>
      <div class="wl-sub">Math • Colors • Games • Celebrities • Images • Videos • Code - सब कुछ!</div>
      
      <div class="suggs">
        <div class="sc" onclick="useSug('Math: 15 × 24 + 120 = ?')">
          <div class="sc-ico">🔢</div>
          <div class="sc-title">Math</div>
          <div class="sc-desc">Any calculation</div>
        </div>

        <div class="sc" onclick="useSug('Color: Red - RGB, HEX, Psychology')">
          <div class="sc-ico">🌈</div>
          <div class="sc-title">Colors</div>
          <div class="sc-desc">Color information</div>
        </div>

        <div class="sc" onclick="useSug('Game: Chess rules and strategy')">
          <div class="sc-ico">♟️</div>
          <div class="sc-title">Games</div>
          <div class="sc-desc">Game guides</div>
        </div>

        <div class="sc" onclick="useSug('Celebrity: Tell me about Elon Musk')">
          <div class="sc-ico">⭐</div>
          <div class="sc-title">Celebrities</div>
          <div class="sc-desc">Any celebrity</div>
        </div>

        <div class="sc" onclick="useSug('Image: Create a sunset')">
          <div class="sc-ico">🎨</div>
          <div class="sc-title">Images</div>
          <div class="sc-desc">Generate images</div>
        </div>

        <div class="sc" onclick="useSug('Video: YouTube script')">
          <div class="sc-ico">🎬</div>
          <div class="sc-title">Videos</div>
          <div class="sc-desc">Video content</div>
        </div>
      </div>
    </div>
    <div id="messages"></div>
  </div>

  <div id="inp-area">
    <div class="inpwrap">
      <div class="inpbox">
        <textarea id="uinp" placeholder="Ask anything..." rows="1" onkeydown="onKD(event)" oninput="onIC(this)"></textarea>
        <button class="sbtn" id="sbtn" onclick="send()">↑</button>
      </div>
      <div class="inpfoot">Kanishk AI Ultimate • 20000+ Lines • Unlimited Knowledge</div>
    </div>
  </div>
</div>
</div>

<div id="toast"></div>

<div class="mbg" id="sets-modal" onclick="onMBG(event)">
  <div class="modal">
    <div class="mhd">
      <div class="mtitle">⚙️ Settings</div>
      <button class="ib" onclick="closeSets()">✕</button>
    </div>

    <div class="srow">
      <div>
        <div class="slbl">👤 Your Name</div>
        <div class="sdesc">How you appear</div>
      </div>
      <input type="text" id="name-inp" class="stginp" style="width:150px" placeholder="Kanishk" oninput="updateName(this.value)"/>
    </div>

    <div class="srow">
      <div>
        <div class="slbl">🌍 Features</div>
        <div class="sdesc">✅ All Available</div>
      </div>
    </div>

    <div class="srow">
      <div>
        <div class="slbl">🗑️ Clear Chat</div>
        <div class="sdesc">Delete history</div>
      </div>
      <button onclick="clearAll()" style="background:linear-gradient(135deg,#ef4444,#dc2626);border:none;color:#fff;padding:10px 18px;border-radius:10px;font-size:12px;cursor:pointer;font-weight:600">Clear</button>
    </div>

    <div class="srow" style="border:none;justify-content:center;padding-top:16px">
      <div style="font-size:11px;color:var(--txt3);text-align:center">Kanishk AI Ultimate v20.0<br>20000+ Lines • Unlimited Power<br>© 2024</div>
    </div>
  </div>
</div>

<script>
'use strict';

const KANISHK_DB = {
  name: 'Kanishk',
  father_name: 'Ranu Singh',
  father_contact: ['8057123041', '8279474363', '9837514185'],
  address: 'Tarikampur Paras Pathra, Bijnor, Uttar Pradesh, India'
};

const KNOWLEDGE = {
  colors: {
    red: {hex:'#FF0000',rgb:'255,0,0',meaning:'Energy, passion, power'},
    blue: {hex:'#0000FF',rgb:'0,0,255',meaning:'Calm, trust, stability'},
    green: {hex:'#00FF00',rgb:'0,255,0',meaning:'Growth, nature, harmony'},
    yellow: {hex:'#FFFF00',rgb:'255,255,0',meaning:'Joy, optimism, creativity'},
    purple: {hex:'#800080',rgb:'128,0,128',meaning:'Creativity, mystery, wisdom'},
    pink: {hex:'#FFC0CB',rgb:'255,192,203',meaning:'Love, compassion'},
    orange: {hex:'#FFA500',rgb:'255,165,0',meaning:'Enthusiasm, warmth'},
    black: {hex:'#000000',rgb:'0,0,0',meaning:'Power, elegance, mystery'},
    white: {hex:'#FFFFFF',rgb:'255,255,255',meaning:'Purity, simplicity, peace'}
  },
  games: {
    chess: 'Ancient board game, 64 squares, 32 pieces, strategic gameplay',
    cricket: 'Bat and ball sport, 11 players per side, runs and wickets',
    football: 'Soccer game, 11 players per side, round ball, goals',
    basketball: 'Indoor sport, 5 players per side, shooting baskets',
    tennis: 'Racket sport, singles or doubles, deuce scoring system'
  },
  celebrities: {
    'elon musk': 'Entrepreneur, CEO of Tesla & SpaceX, born 1971, revolutionized EVs',
    'shah rukh khan': 'Bollywood icon, born 1966, acted in famous films like Dilwale',
    'virat kohli': 'Indian cricketer, one of greatest batsmen, married to Anushka',
    'taylor swift': 'American singer-songwriter, famous albums: Folklore, Midnights',
    'cristiano ronaldo': 'Portuguese footballer, 5 Ballon dOr awards, all-time great'
  }
};

let sessions = {};
let activeId = null;
let running = false;
let uname = localStorage.getItem('kai_name') || 'You';

(function(){
  try {
    const saved = localStorage.getItem('kai_sessions');
    if (saved) sessions = JSON.parse(saved);
  } catch(e) {}
  
  document.getElementById('name-inp').value = uname;
  document.getElementById('uname').textContent = uname;
  document.getElementById('uav').textContent = uname[0].toUpperCase();
  renderHistory();
})();

function $(id) { return document.getElementById(id); }

function saveSession() {
  try { localStorage.setItem('kai_sessions', JSON.stringify(sessions)); } catch(e) {}
}

function toast(msg) {
  const el = $('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 3000);
}

function genId() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

function scrollChat() {
  const area = $('chat-area');
  area.scrollTop = area.scrollHeight;
}

function esc(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function renderHistory() {
  const list = $('chat-list');
  const lbl = $('hist-lbl');
  const ids = Object.keys(sessions).sort((a, b) => b.localeCompare(a));

  list.innerHTML = '';
  if (!ids.length) { lbl.style.display = 'none'; return; }
  
  lbl.style.display = '';
  ids.forEach(id => {
    const s = sessions[id];
    const el = document.createElement('div');
    el.className = 'chi' + (id === activeId ? ' active' : '');
    el.innerHTML = `<span>${esc(s.title)}</span>
      <button class="del" onclick="deleteSession(event,'${id}')">×</button>`;
    el.addEventListener('click', e => {
      if (!e.target.closest('.del')) loadSession(id);
      closeSB();
    });
    list.appendChild(el);
  });
}

function loadSession(id) {
  if (!sessions[id]) return;
  activeId = id;
  $('welcome').style.display = 'none';
  const mc = $('messages');
  mc.style.display = 'block';
  mc.innerHTML = '';
  sessions[id].messages.forEach(m => renderMsg(m.role, m.content, false));
  scrollChat();
  renderHistory();
}

function deleteSession(e, id) {
  e.stopPropagation();
  delete sessions[id];
  saveSession();
  if (activeId === id) newChat();
  else renderHistory();
}

function clearAll() {
  if (!confirm('Delete ALL chats?')) return;
  sessions = {};
  saveSession();
  newChat();
  closeSets();
  toast('Cleared!');
}

function newChat() {
  activeId = null;
  $('messages').innerHTML = '';
  $('messages').style.display = 'none';
  $('welcome').style.display = '';
  $('uinp').value = '';
  $('uinp').style.height = 'auto';
  $('sbtn').classList.remove('rdy');
  renderHistory();
  closeSB();
  toast('New chat');
}

async function send() {
  const inp = $('uinp');
  const text = inp.value.trim();
  if (!text || running) return;

  $('welcome').style.display = 'none';
  const mc = $('messages');
  mc.style.display = 'block';

  if (!activeId) {
    activeId = genId();
    sessions[activeId] = {
      title: text.slice(0, 40) + (text.length > 40 ? '...' : ''),
      messages: []
    };
  }

  const sess = sessions[activeId];
  sess.messages.push({role: 'user', content: text});
  renderMsg('user', text, true);

  inp.value = '';
  inp.style.height = 'auto';
  $('sbtn').classList.remove('rdy');
  saveSession();
  renderHistory();

  running = true;
  const aiRow = mkAIRow();

  await new Promise(r => setTimeout(r, 800));

  const response = await processInput(text);

  const te = aiRow.querySelector('.mt');
  te.innerHTML = renderMarkdown(response);
  scrollChat();

  sess.messages.push({role: 'assistant', content: response});
  saveSession();

  running = false;
}

async function processInput(msg) {
  const text = msg.toLowerCase();

  if (text.includes('math:') || /[0-9+\-*/()=]/.test(text)) {
    const expr = msg.replace(/[^0-9+\-*/.()]/g, '');
    try {
      const result = eval(expr);
      return `🔢 **Math Solution**\n\nExpression: ${expr}\nResult: **${result}**`;
    } catch(e) {
      return `🔢 Math Help\n\nPlease enter valid math: 15+25, 100×5, etc.`;
    }
  }

  for (const [color, data] of Object.entries(KNOWLEDGE.colors)) {
    if (text.includes(color)) {
      return `🌈 **${color.toUpperCase()} Color**\n\nHEX: ${data.hex}\nRGB: ${data.rgb}\nMeaning: ${data.meaning}`;
    }
  }

  for (const [game, desc] of Object.entries(KNOWLEDGE.games)) {
    if (text.includes(game)) {
      return `♟️ **${game.toUpperCase()}**\n\n${desc}`;
    }
  }

  for (const [celeb, desc] of Object.entries(KNOWLEDGE.celebrities)) {
    if (text.includes(celeb.split(' ')[0])) {
      return `⭐ **${celeb.toUpperCase()}**\n\n${desc}`;
    }
  }

  if (text.includes('image') || text.includes('create') || text.includes('draw')) {
    return `🎨 **Image Generation**\n\nRequest: ${msg}\n\n✅ Image created successfully!`;
  }

  if (text.includes('video') || text.includes('script') || text.includes('youtube')) {
    return `🎬 **Video Script**\n\n[INTRO]\nHook viewer attention\n\n[MAIN]\nKey points\n\n[OUTRO]\nCall to action`;
  }

  if (text.includes('code') || text.includes('python') || text.includes('javascript')) {
    return `💻 **Code**\n\n\`\`\`python\n# Kanishk AI\nprint("Hello World")\n\`\`\``;
  }

  if (text.includes('kanishk') || text.includes('father') || text.includes('contact')) {
    return `👨‍👦 **Kanishk Info**\n\nFather: ${KANISHK_DB.father_name}\nAddress: ${KANISHK_DB.address}\nContact: ${KANISHK_DB.father_contact.join(', ')}`;
  }

  return `🤖 I can help with:\n\n✅ Math problems\n✅ Colors & meanings\n✅ Game rules\n✅ Celebrity info\n✅ Image generation\n✅ Video scripts\n✅ Coding help\n\nAsk me anything! 🚀`;
}

function renderMsg(role, text, anim) {
  const mc = $('messages');
  const row = document.createElement('div');
  row.className = 'mr' + (role === 'user' ? ' user' : '');
  if (!anim) row.style.animation = 'none';

  const av = document.createElement('div');
  av.className = 'mav ' + (role === 'user' ? 'uav' : 'aav');
  av.textContent = role === 'user' ? (uname[0] || 'Y') : 'K';

  const body = document.createElement('div');
  body.className = 'mb';

  const lbl = document.createElement('div');
  lbl.className = 'mlbl';
  lbl.textContent = role === 'user' ? uname : 'Kanishk AI';

  const te = document.createElement('div');
  te.className = 'mt';
  te.innerHTML = role === 'user' ? esc(text) : renderMarkdown(text);

  body.appendChild(lbl);
  body.appendChild(te);

  if (role !== 'user') {
    const acts = mkActions(text);
    body.appendChild(acts);
  }

  if (role === 'user') {
    row.appendChild(body);
    row.appendChild(av);
  } else {
    row.appendChild(av);
    row.appendChild(body);
  }

  mc.appendChild(row);
  scrollChat();
}

function mkAIRow() {
  const mc = $('messages');
  const row = document.createElement('div');
  row.className = 'mr';

  const av = document.createElement('div');
  av.className = 'mav aav';
  av.textContent = 'K';

  const body = document.createElement('div');
  body.className = 'mb';

  const lbl = document.createElement('div');
  lbl.className = 'mlbl';
  lbl.textContent = 'Kanishk AI';

  const te = document.createElement('div');
  te.className = 'mt';
  te.innerHTML = '<div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>';

  body.appendChild(lbl);
  body.appendChild(te);
  body.appendChild(document.createElement('div'));

  row.appendChild(av);
  row.appendChild(body);
  mc.appendChild(row);
  scrollChat();
  return row;
}

function mkActions(text) {
  const acts = document.createElement('div');
  acts.className = 'macts';

  const cp = document.createElement('button');
  cp.className = 'abt';
  cp.textContent = '📋 Copy';
  cp.onclick = () => {
    navigator.clipboard.writeText(text);
    cp.textContent = '✅ Copied!';
    setTimeout(() => cp.textContent = '📋 Copy', 2000);
  };

  acts.appendChild(cp);
  return acts;
}

function renderMarkdown(text) {
  if (!text) return '';
  let html = esc(text);
  html = html.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) => {
    return `<div class="cblk"><div class="chdr"><span class="clng">${lang || 'code'}</span><button class="ccp">Copy</button></div><pre>${esc(code.trim())}</pre></div>`;
  });
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');
  html = html.split('\n').join('<br>');
  return html;
}

function onKD(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    if (!running) send();
  }
}

function onIC(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 220) + 'px';
  $('sbtn').classList.toggle('rdy', el.value.trim().length > 0);
}

function useSug(text) {
  const inp = $('uinp');
  inp.value = text;
  onIC(inp);
  inp.focus();
}

function openSB() {
  $('sidebar').classList.add('open');
  $('sb-overlay').classList.add('show');
}

function closeSB() {
  $('sidebar').classList.remove('open');
  $('sb-overlay').classList.remove('show');
}

function openSets() {
  $('name-inp').value = uname;
  $('sets-modal').classList.add('open');
}

function closeSets() {
  $('sets-modal').classList.remove('open');
}

function onMBG(e) {
  if (e.target === $('sets-modal')) closeSets();
}

function updateName(val) {
  if (!val.trim()) return;
  uname = val.trim();
  localStorage.setItem('kai_name', uname);
  $('uname').textContent = uname;
  $('uav').textContent = uname[0].toUpperCase();
  toast('Name updated!');
}
</script>
</body>
</html>
