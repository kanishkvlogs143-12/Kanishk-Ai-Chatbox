<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
<title>Kanishk AI - Ultra Powerful Omni AI</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&family=Poppins:wght@600;700;800&display=swap');

* { 
  margin: 0; 
  padding: 0; 
  box-sizing: border-box; 
}

:root {
  --bg: #0a0a0a;
  --bg2: #121212;
  --bg3: #1a1a1a;
  --bg4: #252525;
  --sb: #0f0f0f;
  --hov: #2a2a2a;
  --ibg: #171717;
  --txt: #f5f5f5;
  --txt2: #b0b0b0;
  --txt3: #808080;
  --txt4: #606060;
  --green: #10a37f;
  --green-dark: #0d7a60;
  --green-light: #1abc9c;
  --accent: #7c3aed;
  --accent2: #a855f7;
  --pink: #ec4899;
  --pink-dark: #be185d;
  --bdr: #3d3d3d;
  --bdr2: #4a4a4a;
  --success: #10b981;
  --warning: #f59e0b;
  --error: #ef4444;
  --info: #3b82f6;
  --r: 14px;
  --rsm: 10px;
  --sw: 300px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.4);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.5);
}

html, body {
  height: 100%;
  background: var(--bg);
  color: var(--txt);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  font-size: 15px;
  line-height: 1.6;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--bdr);
  border-radius: 8px;
  border: 2px solid var(--bg);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--bdr2);
}

* {
  scrollbar-width: thin;
  scrollbar-color: var(--bdr) transparent;
}

#app {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* ============= SIDEBAR STYLES ============= */
#sidebar {
  width: var(--sw);
  background: var(--sb);
  border-right: 1px solid var(--bdr);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  z-index: 100;
  box-shadow: var(--shadow-md);
}

.sb-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 16px;
  border-bottom: 1px solid var(--bdr);
  background: linear-gradient(135deg, rgba(16,163,127,0.1) 0%, transparent 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16px;
  font-weight: 800;
  color: var(--txt);
  text-decoration: none;
  letter-spacing: -0.5px;
  font-family: 'Poppins', sans-serif;
}

.brand-icon {
  width: 36px;
  height: 36px;
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 8px 20px rgba(16, 163, 127, 0.4);
  flex-shrink: 0;
  animation: pulse-glow 2s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 8px 20px rgba(16, 163, 127, 0.4); }
  50% { box-shadow: 0 8px 30px rgba(16, 163, 127, 0.6); }
}

.ib {
  background: none;
  border: none;
  color: var(--txt2);
  cursor: pointer;
  padding: 10px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.ib:hover {
  background: var(--hov);
  color: var(--green);
  transform: scale(1.08);
}

.ib:active {
  transform: scale(0.95);
}

.new-chat {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 10px;
  padding: 13px 16px;
  border-radius: var(--rsm);
  border: 1.5px solid transparent;
  background: linear-gradient(135deg, var(--accent2) 0%, var(--accent) 100%);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: left;
  box-shadow: 0 4px 15px rgba(122, 60, 237, 0.3);
}

.new-chat:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(122, 60, 237, 0.4);
}

.new-chat svg {
  flex-shrink: 0;
}

.sb-sec {
  padding: 12px 18px 8px;
  font-size: 12px;
  font-weight: 700;
  color: var(--txt3);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-top: 12px;
}

#chat-list {
  flex: 1;
  overflow-y: auto;
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.chi {
  padding: 12px 14px;
  border-radius: var(--rsm);
  cursor: pointer;
  font-size: 13px;
  color: var(--txt2);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border: 1px solid transparent;
}

.chi:hover {
  background: var(--hov);
  color: var(--txt);
  border-color: var(--bdr2);
  transform: translateX(4px);
}

.chi.active {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  color: #fff;
  border-color: var(--green);
  box-shadow: 0 4px 12px rgba(16, 163, 127, 0.3);
}

.chi .del {
  display: none;
  background: none;
  border: none;
  color: var(--txt3);
  cursor: pointer;
  padding: 6px 8px;
  border-radius: 6px;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.chi:hover .del {
  display: flex;
  align-items: center;
}

.chi .del:hover {
  color: #fff;
  background: rgba(239, 68, 68, 0.8);
}

.sb-bot {
  border-top: 1px solid var(--bdr);
  padding: 12px;
  background: linear-gradient(180deg, transparent 0%, rgba(16,163,127,0.05) 100%);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: var(--rsm);
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

.user-row:hover {
  background: var(--hov);
  border-color: var(--bdr2);
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(122, 60, 237, 0.3);
}

.uname {
  font-size: 13px;
  font-weight: 600;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#sb-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 50;
  backdrop-filter: blur(5px);
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ============= MAIN AREA STYLES ============= */
#main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
}

#topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 1px solid var(--bdr);
  flex-shrink: 0;
  gap: 12px;
  background: linear-gradient(135deg, var(--bg2) 0%, var(--bg3) 100%);
  box-shadow: var(--shadow-sm);
}

.model-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border: 1px solid var(--bdr);
  border-radius: 24px;
  background: var(--bg3);
  color: var(--txt);
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s ease;
}

.model-btn:hover {
  background: var(--hov);
  border-color: var(--green);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(16, 163, 127, 0.2);
}

.model-indicator {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--success);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.1); }
}

.tb-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

#mob-topbar {
  display: none;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid var(--bdr);
  flex-shrink: 0;
  background: var(--bg2);
}

.mob-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  font-weight: 700;
  color: var(--txt);
}

/* ============= CHAT AREA STYLES ============= */
#chat-area {
  flex: 1;
  overflow-y: auto;
  scroll-behavior: smooth;
  position: relative;
}

#welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  padding: 50px 20px 180px;
  text-align: center;
  background: linear-gradient(180deg, var(--bg) 0%, var(--bg2) 100%);
}

.wl-logo {
  width: 72px;
  height: 72px;
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  font-weight: 800;
  color: #fff;
  margin-bottom: 28px;
  box-shadow: 0 12px 40px rgba(16, 163, 127, 0.4);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.wl-title {
  font-size: 32px;
  font-weight: 800;
  color: var(--txt);
  letter-spacing: -1px;
  margin-bottom: 12px;
  font-family: 'Poppins', sans-serif;
}

.wl-badge {
  display: inline-block;
  background: linear-gradient(135deg, rgba(16, 163, 127, 0.15) 0%, rgba(26, 188, 156, 0.15) 100%);
  border: 1.5px solid var(--green);
  color: var(--green);
  padding: 8px 16px;
  border-radius: 24px;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 24px;
  letter-spacing: 0.5px;
}

.wl-sub {
  font-size: 16px;
  color: var(--txt2);
  margin-bottom: 48px;
  max-width: 500px;
  line-height: 1.8;
  font-weight: 500;
}

.suggs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
  max-width: 800px;
  width: 100%;
}

.sc {
  background: var(--bg3);
  border: 1px solid var(--bdr);
  border-radius: var(--r);
  padding: 18px;
  text-align: left;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-family: inherit;
  color: var(--txt);
}

.sc:hover {
  background: var(--bg4);
  border-color: var(--green);
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(16, 163, 127, 0.25);
}

.sc-ico {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(16, 163, 127, 0.2) 0%, rgba(26, 188, 156, 0.2) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  font-size: 20px;
  border: 1px solid rgba(16, 163, 127, 0.3);
}

.sc-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--txt);
  margin-bottom: 6px;
}

.sc-desc {
  font-size: 12px;
  color: var(--txt3);
}

/* ============= MESSAGE STYLES ============= */
#messages {
  display: none;
  max-width: 900px;
  margin: 0 auto;
  padding: 32px 20px 200px;
  width: 100%;
}

.mr {
  display: flex;
  gap: 16px;
  margin-bottom: 24px;
  animation: slideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mr.user {
  flex-direction: row-reverse;
}

.mav {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  margin-top: 4px;
}

.mav.aav {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  color: #fff;
  box-shadow: 0 4px 12px rgba(16, 163, 127, 0.3);
}

.mav.uav {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  color: #fff;
  box-shadow: 0 4px 12px rgba(122, 60, 237, 0.3);
}

.mb {
  flex: 1;
  min-width: 0;
}

.mlbl {
  font-size: 12px;
  font-weight: 700;
  color: var(--txt2);
  margin-bottom: 8px;
  letter-spacing: 0.5px;
}

.mt {
  font-size: 15px;
  line-height: 1.8;
  color: var(--txt);
  word-break: break-word;
}

.mr.user .mt {
  background: linear-gradient(135deg, var(--accent2) 0%, var(--accent) 100%);
  border: 1px solid rgba(168, 85, 247, 0.3);
  padding: 14px 18px;
  border-radius: 18px 18px 4px 18px;
  display: inline-block;
  max-width: 100%;
  color: #fff;
  box-shadow: 0 4px 12px rgba(122, 60, 237, 0.2);
}

.mt p {
  margin-bottom: 14px;
}

.mt p:last-child {
  margin-bottom: 0;
}

.mt ul, .mt ol {
  padding-left: 28px;
  margin-bottom: 14px;
}

.mt li {
  margin-bottom: 8px;
}

.mt strong {
  font-weight: 700;
  color: var(--green);
}

.mt em {
  font-style: italic;
  color: var(--txt2);
}

.mt a {
  color: var(--green-light);
  text-decoration: underline;
  transition: all 0.2s ease;
}

.mt a:hover {
  color: var(--green);
  text-decoration-thickness: 2px;
}

.mt h1 {
  font-size: 24px;
  font-weight: 800;
  margin: 24px 0 12px;
  color: var(--txt);
  font-family: 'Poppins', sans-serif;
}

.mt h2 {
  font-size: 20px;
  font-weight: 800;
  margin: 20px 0 10px;
  color: var(--txt);
  font-family: 'Poppins', sans-serif;
}

.mt h3 {
  font-size: 18px;
  font-weight: 700;
  margin: 18px 0 8px;
  color: var(--txt);
}

.mt h4, .mt h5, .mt h6 {
  font-size: 15px;
  font-weight: 700;
  margin: 14px 0 6px;
  color: var(--txt);
}

.mt blockquote {
  border-left: 4px solid var(--green);
  padding: 12px 18px;
  color: var(--txt2);
  margin: 14px 0;
  background: linear-gradient(90deg, rgba(16, 163, 127, 0.1) 0%, transparent 100%);
  border-radius: 0 6px 6px 0;
  font-style: italic;
  font-weight: 500;
}

.mt code {
  background: var(--bg);
  border: 1px solid var(--bdr);
  border-radius: 6px;
  padding: 3px 10px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  color: var(--green-light);
  font-weight: 600;
}

.mt table {
  width: 100%;
  border-collapse: collapse;
  margin: 14px 0;
  font-size: 13px;
}

.mt th, .mt td {
  padding: 12px 14px;
  border: 1px solid var(--bdr);
  text-align: left;
}

.mt th {
  background: var(--bg3);
  font-weight: 700;
  color: var(--green);
}

.mt tr:nth-child(even) td {
  background: rgba(0, 0, 0, 0.15);
}

.mt hr {
  border: none;
  border-top: 1px solid var(--bdr);
  margin: 20px 0;
}

/* ============= IMAGE STYLES ============= */
.img-container {
  margin: 16px 0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  max-width: 500px;
}

.img-container img {
  width: 100%;
  height: auto;
  display: block;
}

.img-actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  flex-wrap: wrap;
}

.img-btn {
  background: linear-gradient(135deg, var(--green) 0%, var(--green-dark) 100%);
  border: none;
  color: #fff;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 12px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.2s ease;
  font-family: inherit;
}

.img-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(16, 163, 127, 0.3);
}

/* ============= CODE BLOCK STYLES ============= */
.cblk {
  background: var(--bg);
  border: 1px solid var(--bdr);
  border-radius: var(--rsm);
  margin: 14px 0;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.chdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid var(--bdr);
  background: var(--bg3);
}

.clng {
  font-size: 11px;
  color: var(--txt3);
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.ccp {
  background: none;
  border: none;
  color: var(--txt3);
  font-size: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  border-radius: 6px;
  font-family: inherit;
  transition: all 0.2s ease;
  font-weight: 600;
}

.ccp:hover {
  color: var(--green);
  background: rgba(16, 163, 127, 0.15);
}

.cblk pre {
  padding: 16px;
  overflow-x: auto;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  line-height: 1.7;
  color: var(--txt);
  white-space: pre;
}

.cblk pre code {
  background: none;
  border: none;
  padding: 0;
  color: inherit;
}

/* ============= MESSAGE ACTIONS ============= */
.macts {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  opacity: 0;
  transition: opacity 0.2s ease;
  flex-wrap: wrap;
}

.mr:hover .macts {
  opacity: 1;
}

.abt {
  background: none;
  border: none;
  color: var(--txt3);
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-family: inherit;
  transition: all 0.15s ease;
  font-weight: 600;
}

.abt:hover {
  background: var(--hov);
  color: var(--txt);
  transform: scale(1.05);
}

.abt.liked {
  color: var(--success);
  background: rgba(16, 185, 129, 0.1);
}

.abt.disliked {
  color: var(--error);
  background: rgba(239, 68, 68, 0.1);
}

/* ============= TYPING INDICATOR ============= */
.dots {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 14px 0;
}

.dot {
  width: 8px;
  height: 8px;
  background: var(--txt3);
  border-radius: 50%;
  animation: bounce 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.7;
  }
  30% {
    transform: translateY(-10px);
    opacity: 1;
  }
}

.scur::after {
  content: '|';
  animation: blink 0.7s infinite;
  color: var(--green);
  font-weight: 700;
  margin-left: 3px;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* ============= INPUT AREA STYLES ============= */
#inp-area {
  flex-shrink: 0;
  padding: 12px 18px 18px;
  background: var(--bg);
  position: relative;
}

#inp-area::before {
  content: '';
  position: absolute;
  top: -50px;
  left: 0;
  right: 0;
  height: 50px;
  background: linear-gradient(transparent, var(--bg));
