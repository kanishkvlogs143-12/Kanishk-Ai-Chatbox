/* ============= STATE MANAGEMENT ============= */
const aiEngine = new AIEngine();
let sessions = {};
let activeId = null;
let running = false;
let uname = localStorage.getItem('kai_name') || 'You';

/* ============= INITIALIZATION ============= */
(function() {
  try {
    const saved = localStorage.getItem('kai_sessions');
    if (saved) sessions = JSON.parse(saved);
  } catch (e) {
    console.log('No saved sessions');
  }

  document.getElementById('name-inp').value = uname;
  document.getElementById('uname').textContent = uname;
  document.getElementById('uav').textContent = uname[0]?.toUpperCase() || 'Y';
  renderHistory();
})();

/* ============= CORE FUNCTIONS ============= */
function $(id) {
  return document.getElementById(id);
}

function saveSession() {
  try {
    localStorage.setItem('kai_sessions', JSON.stringify(sessions));
  } catch (e) {
    toast('Storage Full');
  }
}

function toast(msg) {
  const el = $('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 3500);
}

function genId() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

function scrollChat() {
  const area = $('chat-area');
  area.scrollTop = area.scrollHeight;
}

function esc(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

/* ============= HISTORY FUNCTIONS ============= */
function renderHistory() {
  const list = $('chat-list');
  const lbl = $('hist-lbl');
  const ids = Object.keys(sessions).sort((a, b) => b.localeCompare(a));

  list.innerHTML = '';

  if (!ids.length) {
    lbl.style.display = 'none';
    return;
  }

  lbl.style.display = '';

  ids.forEach(id => {
    const s = sessions[id];
    const el = document.createElement('div');
    el.className = 'chi' + (id === activeId ? ' active' : '');
    el.title = s.title;
    el.innerHTML = `<span>${esc(s.title)}</span>
      <button class="del" onclick="deleteSession(event, '${id}')">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-1 14H6L5 6"/>
          <path d="M10 11v6M14 11v6"/>
        </svg>
      </button>`;
    el.addEventListener('click', e => {
      if (!e.target.closest('.del')) loadSession(id);
      closeSB();
    });
    list.appendChild(el);
  });
}

function loadSession(id) {
  if (!sessions[id]) return;
  activeId = id;
  $('welcome').style.display = 'none';
  const mc = $('messages');
  mc.style.display = 'block';
  mc.innerHTML = '';

  sessions[id].messages.forEach(m => renderMsg(m.role, m.content, false));
  scrollChat();
  renderHistory();
  toast('Chat loaded');
}

function deleteSession(e, id) {
  e.stopPropagation();
  delete sessions[id];
  saveSession();
  if (activeId === id) newChat();
  else renderHistory();
  toast('Chat deleted');
}

function clearAll() {
  if (!confirm('Delete ALL chats? This cannot be undone!')) return;
  sessions = {};
  saveSession();
  newChat();
  closeSets();
  toast('All chats cleared');
}

function newChat() {
  activeId = null;
  const mc = $('messages');
  mc.innerHTML = '';
  mc.style.display = 'none';
  $('welcome').style.display = '';
  $('uinp').value = '';
  $('uinp').style.height = 'auto';
  $('sbtn').classList.remove('rdy');
  renderHistory();
  closeSB();
  toast('✨ New chat started');
}

/* ============= MESSAGE FUNCTIONS ============= */
async function send() {
  const inp = $('uinp');
  const text = inp.value.trim();

  if (!text || running) return;

  $('welcome').style.display = 'none';
  const mc = $('messages');
  mc.style.display = 'block';

  if (!activeId) {
    activeId = genId();
    sessions[activeId] = {
      title: text.slice(0, 40) + (text.length > 40 ? '...' : ''),
      messages: []
    };
  }

  const sess = sessions[activeId];
  sess.messages.push({ role: 'user', content: text });
  renderMsg('user', text, true);

  inp.value = '';
  inp.style.height = 'auto';
  $('sbtn').classList.remove('rdy');
  saveSession();
  renderHistory();

  running = true;
  setBtn(true);
  const aiRow = mkAIRow();

  await new Promise(r => setTimeout(r, 900));

  const response = await aiEngine.processInput(text);

  const te = aiRow.querySelector('.mt');
  te.innerHTML = renderMarkdown(response);
  te.classList.remove('scur');
  scrollChat();

  sess.messages.push({ 
    role: 'assistant', 
    content: response
  });
  saveSession();

  running = false;
  setBtn(false);
}

function renderMsg(role, text, anim) {
  const mc = $('messages');
  const row = document.createElement('div');
  row.className = 'mr' + (role === 'user' ? ' user' : '');

  if (!anim) row.style.animation = 'none';

  const av = document.createElement('div');
  av.className = 'mav ' + (role === 'user' ? 'uav' : 'aav');
  av.textContent = role === 'user' ? (uname[0]?.toUpperCase() || 'Y') : 'K';

  const body = document.createElement('div');
  body.className = 'mb';

  const lbl = document.createElement('div');
  lbl.className = 'mlbl';
  lbl.textContent = role === 'user' ? uname : 'Kanishk AI';

  const te = document.createElement('div');
  te.className = 'mt';

  if (role === 'user') {
    te.textContent = text;
  } else {
    te.innerHTML = renderMarkdown(text);
  }

  body.appendChild(lbl);
  body.appendChild(te);

  if (role !== 'user') {
    const acts = mkActions(text);
    body.appendChild(acts);
  }

  if (role === 'user') {
    row.appendChild(body);
    row.appendChild(av);
  } else {
    row.appendChild(av);
    row.appendChild(body);
  }

  mc.appendChild(row);
  scrollChat();
  return row;
}

function mkAIRow() {
  const mc = $('messages');
  const row = document.createElement('div');
  row.className = 'mr';

  const av = document.createElement('div');
  av.className = 'mav aav';
  av.textContent = 'K';

  const body = document.createElement('div');
  body.className = 'mb';

  const lbl = document.createElement('div');
  lbl.className = 'mlbl';
  lbl.textContent = 'Kanishk AI';

  const te = document.createElement('div');
  te.className = 'mt scur';
  te.innerHTML = '<div class="dots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>';

  const acts = document.createElement('div');
  acts.className = 'macts';

  body.appendChild(lbl);
  body.appendChild(te);
  body.appendChild(acts);

  row.appendChild(av);
  row.appendChild(body);

  mc.appendChild(row);
  scrollChat();
  return row;
}

function mkActions(text) {
  const acts = document.createElement('div');
  acts.className = 'macts';

  const cp = document.createElement('button');
  cp.className = 'abt';
  cp.innerHTML = '📋 Copy';
  cp.onclick = () => {
    navigator.clipboard.writeText(text).then(() => {
      cp.innerHTML = '✅ Copied!';
      setTimeout(() => (cp.innerHTML = '📋 Copy'), 2000);
    });
  };

  const like = document.createElement('button');
  like.className = 'abt';
  like.innerHTML = '👍 Helpful';
  like.onclick = () => {
    like.classList.toggle('liked');
    toast(like.classList.contains('liked') ? '❤️ Thanks!' : 'Feedback removed');
  };

  acts.appendChild(cp);
  acts.appendChild(like);
  return acts;
}

/* ============= MARKDOWN RENDERING ============= */
function renderMarkdown(text) {
  if (!text) return '';

  let html = esc(text);

  // Code blocks
  html = html.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) => {
    return `<div class="cblk"><div class="chdr"><span class="clng">${lang || 'code'}</span></div><pre><code>${esc(code.trim())}</code></pre></div>`;
  });

  // Bold
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

  // Italic  
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');

  // Headings
  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');

  // Line breaks
  html = html.split('\n').join('<br>');

  return html;
}

/* ============= UI FUNCTIONS ============= */
function onKD(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    if (!running) send();
  }
}

function onIC(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 220) + 'px';
  $('sbtn').classList.toggle('rdy', el.value.trim().length > 0);
}

function useSug(text) {
  const inp = $('uinp');
  inp.value = text;
  onIC(inp);
  inp.focus();
}

function setBtn(on) {
  const b = $('sbtn');
  if (on) {
    b.className = 'stpbtn';
  } else {
    b.className = 'sbtn';
  }
}

function openSB() {
  $('sidebar').classList.add('open');
  $('sb-overlay').classList.add('show');
}

function closeSB() {
  $('sidebar').classList.remove('open');
  $('sb-overlay').classList.remove('show');
}

function openSets() {
  $('name-inp').value = uname;
  $('sets-modal').classList.add('open');
}

function closeSets() {
  $('sets-modal').classList.remove('open');
}

function onMBG(e) {
  if (e.target === $('sets-modal')) closeSets();
}

function updateName(val) {
  if (!val.trim()) return;
  uname = val.trim();
  localStorage.setItem('kai_name', uname);
  $('uname').textContent = uname;
  $('uav').textContent = uname[0]?.toUpperCase() || 'Y';
  toast('✅ Name updated');
}
